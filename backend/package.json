{
  "name": "smart-scribe-backend",
  "version": "1.0.0",
  "description": "AI 网文生成工具后端",
  "main": "dist/backend/src/app.js",
  "scripts": {
    "start": "node dist/backend/src/app.js",
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "db:init": "tsx scripts/initDb.ts",
    "db:migrate:rbac-usage": "tsx scripts/migrateRbacUsage.ts",
    "db:migrate:novel-outline": "tsx scripts/migrateNovelOutline.ts",
    "db:migrate:novel-version": "tsx scripts/migrateNovelVersion.ts",
    "db:migrate:feedback": "tsx scripts/migrateFeedback.ts",
    "db:migrate:ai-credential": "tsx scripts/migrateAiCredential.ts",
    "db:migrate:human-collaboration": "tsx scripts/migrateHumanCollaboration.ts",
    "db:migrate:phase1-3": "npm run db:migrate:human-collaboration",
    "db:migrate:ai-usage-billing": "tsx scripts/migrateAiUsageBilling.ts",
    "db:migrate:ai-key-preference": "tsx scripts/migrateAiKeyPreference.ts",
    "db:migrate:all": "npm run db:migrate:rbac-usage && npm run db:migrate:novel-outline && npm run db:migrate:novel-version && npm run db:migrate:feedback && npm run db:migrate:ai-credential && npm run db:migrate:human-collaboration && npm run db:migrate:ai-usage-billing && npm run db:migrate:ai-key-preference",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.1",
    "sequelize": "^6.35.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.4",
    "globals": "^17.11.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
